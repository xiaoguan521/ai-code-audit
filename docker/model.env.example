# 宿主机运行时复制为 /etc/ai-audit/model.env；Compose 运行时复制为 model.env。
# 权限 600。Docker 环境文件的值不要加引号，也不要提交真实密钥。

# 自部署 OpenAI Chat Completions 兼容服务（例如千问）。模型名必须与服务暴露的 ID 完全一致。
# 地址填写接口根路径 /v1，不要把 /chat/completions 拼进去。
OPENAI_BASE_URL=http://qwen-server:8000/v1
OPENAI_MODEL=your-served-model-id
# 无鉴权的服务可填 EMPTY；需要鉴权时填写实际密钥。
OPENAI_API_KEY=EMPTY
# 两个值按模型服务实际能力调整；上下文和输出令牌都包含思考内容。
OPENAI_CONTEXT_WINDOW=131072
OPENAI_MAX_OUTPUT_TOKENS=8192

# 改用 DeepSeek 官方 Messages 接口时，先删除或注释上面的 OPENAI_* 项，再填写：
# DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic
# DEEPSEEK_API_KEY=changeme
# 当前官方默认模型为 deepseek-flash；DEEPSEEK_MODEL 不能保证切换模型。

# 以下设置只用于回滚到旧 Pi 扫描镜像：
# PI_CONTEXT_WINDOW=128000
# PI_MAX_OUTPUT_TOKENS=16384
# PI_TEMPERATURE=0
# PI_RESPONSE_FORMAT=json_schema
