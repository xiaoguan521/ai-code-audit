# 宿主机运行时复制为 /etc/ai-audit/model.env；Compose 运行时复制为项目目录下的 model.env。
# 权限 600，仅运行账号可读。不要给值添加引号。
# DeepSeek Harness 官方 Messages API 或内网兼容网关地址；不填时使用官方地址。
DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic
# DeepSeek Harness 的 API Key 变量名固定为 DEEPSEEK_API_KEY。
DEEPSEEK_API_KEY=changeme
# 可选：内网网关注册的 DeepSeek 模型名；不填使用 Harness Profile 默认模型。
DEEPSEEK_MODEL=deepseek-flash

# Pi 回滚链路才使用以下 OpenAI 兼容配置；默认 Harness 不读取它们。
# OPENAI_BASE_URL=http://qwen.internal.example.com:8000/v1
# OPENAI_API_KEY=changeme
# OPENAI_MODEL=qwen3-coder
# PI_CONTEXT_WINDOW=128000
# PI_MAX_OUTPUT_TOKENS=16384
# PI_TEMPERATURE=0
# PI_RESPONSE_FORMAT=json_schema
