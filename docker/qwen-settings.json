{
  "security": {
    "auth": {
      "selectedType": "openai",
      "enforcedType": "openai"
    },
    "folderTrust": {
      "enabled": false
    }
  },
  "general": {
    "enableAutoUpdate": false
  },
  "privacy": {
    "usageStatisticsEnabled": false
  },
  "telemetry": {
    "enabled": false,
    "logPrompts": false
  },
  "tools": {
    "approvalMode": "default"
  },
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "ListFiles",
      "Skill",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(git ls-files *)",
      "Bash(git rev-parse *)",
      "Bash(git blame *)",
      "Bash(wc *)",
      "Bash(ls *)"
    ],
    "deny": [
      "Edit",
      "Write",
      "notebook_edit",
      "WebFetch",
      "image_gen",
      "Agent",
      "Bash(git push *)",
      "Bash(git commit *)",
      "Bash(git checkout *)",
      "Bash(git reset *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(rm *)",
      "Bash(npm *)",
      "Bash(pip *)"
    ]
  },
  "skills": {
    "directories": [
      "/opt/audit/skills"
    ]
  }
}