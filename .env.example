# 运行数据必须使用宿主机上的绝对路径；从项目目录执行 Compose 时会展开 PWD。
AUDIT_DATA_DIR=${PWD}/audit-data
# 扫描容器加入的网络，需确保能够访问内网模型服务。
AUDIT_MODEL_NETWORK=ai-audit-model-net
# Qwen Code 扫描镜像；也可以替换为内网镜像仓库地址。
AUDIT_SCANNER_IMAGE=ghcr.io/xiaoguan521/ai-code-audit:main
# 批量调度镜像，由同一 GitHub Actions 工作流构建并发布。
AUDIT_RUNNER_IMAGE=ghcr.io/xiaoguan521/ai-code-audit-runner:main
# Linux 和 Docker Desktop 通常使用此路径；其他环境按实际 Docker socket 修改。
AUDIT_DOCKER_SOCKET=/var/run/docker.sock
