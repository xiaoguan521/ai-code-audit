# 运行数据必须使用宿主机上的绝对路径；从项目目录执行 Compose 时会展开 PWD。
AUDIT_DATA_DIR=${PWD}/audit-data
# 扫描容器加入的网络，需确保能够访问内网模型服务。
AUDIT_MODEL_NETWORK=ai-audit-model-net
# 默认扫描镜像由本仓库构建并发布，内置 DeepSeek Harness、八性 Skill 和 headless Profile。
AUDIT_SCANNER_IMAGE=ghcr.io/xiaoguan521/ai-code-audit:main
# 扫描任务由 DeepSeek Harness 的完整 Agent Loop 自主规划和执行。
AUDIT_AGENT_TYPE=deepseek-harness
# Harness 参数；必须是 JSON 数组，不能写 shell 字符串。
AUDIT_HARNESS_BIN=dsh
AUDIT_HARNESS_ARGS=["headless","--json","--permission-mode","read-only","--approval-policy","never"]
# 每批次最多并行的项目数及共享工作目录内的模型会话数，按模型服务并发能力调整。
# 可选：位于 AUDIT_DATA_DIR 内、已挂载的 Semgrep 离线规则目录绝对路径。
AUDIT_SEMGREP_RULES_DIR=
AUDIT_MAX_PARALLEL=2
AUDIT_MAX_MODEL_CONCURRENCY=2
# 单次 Harness 运行最长秒数；不包含预扫描及等待模型并发名额的时间。
AUDIT_PER_PROJECT_TIMEOUT_SEC=3600
# 每日批量巡检设为 true；只生成结论和评分，不生成详细证据。也可运行时加 --fast。
AUDIT_FAST_MODE=false
# 是否启动独立 Summary Agent；Harness 模式开启后默认复用扫描镜像，但仍是独立会话。
AUDIT_SUMMARY_ENABLED=true
# 需要单独的总结镜像/网络/凭据时再覆盖；留空复用扫描配置。
AUDIT_SUMMARY_IMAGE=
AUDIT_SUMMARY_NETWORK=
AUDIT_SUMMARY_MODEL_ENV_PATH=
# 批量调度镜像，由同一 GitHub Actions 工作流构建并发布。
AUDIT_RUNNER_IMAGE=ghcr.io/xiaoguan521/ai-code-audit-runner:main
# Linux 和 Docker Desktop 通常使用此路径；其他环境按实际 Docker socket 修改。
AUDIT_DOCKER_SOCKET=/var/run/docker.sock
