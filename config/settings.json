{
  "workdir": "/data/ai-audit/work",
  "output_dir": "/data/ai-audit/output",
  "model": "",
  "max_parallel": 2,
  "max_model_concurrency": 2,
  "model_queue_timeout_sec": 1800,
  "batch_timeout_sec": 43200,
  "prescan_timeouts": {},
  "per_project_timeout_sec": 3600,
  "adaptive_timeout": true,
  "scale_timeouts": {
    "small": 1800,
    "medium": 3600,
    "large": 5400
  },
  "fast_mode": false,
  "snapshot_at": "",
  "clone_depth": 200,
  "default_scope_out": [
    "vendor/",
    "node_modules/",
    "dist/",
    "build/",
    "target/",
    ".git/",
    "third_party/",
    "*.min.js",
    "*.lock"
  ],
  "prescan_tools": [
    "cloc",
    "gitleaks",
    "semgrep",
    "lizard"
  ],
  "prescan_parallelism": 2,
  "summary": {
    "enabled": true,
    "timeout_sec": 900,
    "_说明": "独立 Harness 会话只读取本次项目 Markdown；汇总失败时保留项目报告及索引"
  },
  "agent": {
    "type": "deepseek-harness",
    "strategy": "single",
    "launcher": "docker",
    "image": "ghcr.io/xiaoguan521/ai-code-audit:main",
    "env_file": "/etc/ai-audit/model.env",
    "network": "ai-audit-model-net",
    "bin": "dsh",
    "args": [
      "headless",
      "--json",
      "--permission-mode",
      "read-only",
      "--approval-policy",
      "never"
    ],
    "memory": "6g",
    "cpus": 2,
    "_说明": "只支持 DeepSeek Harness；必须 strategy=single，由完整 Harness Agent Loop 自己拆分任务，不由 Runner 按维度拆分"
  }
}
