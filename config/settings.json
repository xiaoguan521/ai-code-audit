{
  "workdir": "/data/ai-audit/work",
  "output_dir": "/data/ai-audit/output",
  "claude_bin": "claude",
  "model": "",
  "max_parallel": 2,
  "max_model_concurrency": 2,
  "per_project_timeout_sec": 3600,
  "per_project_budget_usd": 15,
  "full_scan_weekday": 6,
  "full_scan_strategy": "weekday",
  "full_scan_interval_days": 7,
  "clone_depth": 200,
  "code_map_enabled": true,
  "code_map_max_entries": 120,
  "default_scope_out": [
    "vendor/",
    "node_modules/",
    "dist/",
    "build/",
    "target/",
    ".git/",
    "third_party/",
    "*.min.js",
    "*.lock"
  ],
  "prescan_tools": [
    "cloc",
    "gitleaks",
    "semgrep",
    "lizard"
  ],
  "prescan_parallelism": 1,
  "alert": {
    "score_drop_threshold": 1.0,
    "new_p0": true
  },
  "agent": {
    "type": "pi-docker",
    "strategy": "dimensions",
    "dimension_parallelism": 4,
    "image": "ai-code-audit:1.0",
    "env_file": "/etc/ai-audit/model.env",
    "network": "",
    "memory": "6g",
    "cpus": 2,
    "max_session_turns": 300,
    "_说明": "type 可选 pi-docker（内网 OpenAI 兼容模型）或 claude；pi-docker 必须填 network，留空拒绝启动，确需默认网桥显式填 bridge。旧的 qwen-docker 名称保留兼容，应使用 Pi 扫描镜像"
  }
}
