{
  "workdir": "/data/ai-audit/work",
  "output_dir": "/data/ai-audit/output",
  "claude_bin": "claude",
  "model": "",
  "max_parallel": 2,
  "max_model_concurrency": 2,
  "per_project_timeout_sec": 3600,
  "per_project_budget_usd": 15,
  "full_scan_weekday": 6,
  "full_scan_strategy": "weekday",
  "full_scan_interval_days": 7,
  "clone_depth": 200,
  "code_map_enabled": true,
  "code_map_max_entries": 120,
  "default_scope_out": [
    "vendor/",
    "node_modules/",
    "dist/",
    "build/",
    "target/",
    ".git/",
    "third_party/",
    "*.min.js",
    "*.lock"
  ],
  "prescan_tools": [
    "cloc",
    "gitleaks",
    "semgrep",
    "lizard"
  ],
  "prescan_parallelism": 2,
  "alert": {
    "score_drop_threshold": 1.0,
    "new_p0": true
  },
  "summary": {
    "enabled": false,
    "timeout_sec": 900,
    "agent": {
      "type": "deepseek-harness",
      "strategy": "single",
      "launcher": "docker",
      "image": "deepseek-harness:固定版本",
      "network": "ai-audit-net",
      "bin": "dsh",
      "args": ["headless", "--json", "--permission-mode", "read-only", "--approval-policy", "never"],
      "env_file": "/etc/ai-audit/deepseek.env"
    },
    "_说明": "enabled=true 时启动独立 Summary Agent；它只读取 audit.md/audit.json，不读取源码；未配置凭证、启动失败或输出无效时自动使用确定性摘要，不影响审查评分"
  },
  "agent": {
    "type": "deepseek-harness",
    "strategy": "single",
    "launcher": "docker",
    "image": "ghcr.io/xiaoguan521/ai-code-audit:main",
    "env_file": "/etc/ai-audit/model.env",
    "network": "ai-audit-model-net",
    "bin": "dsh",
    "args": ["headless", "--json", "--permission-mode", "read-only", "--approval-policy", "never"],
    "memory": "6g",
    "cpus": 2,
    "max_session_turns": 300,
    "_说明": "默认使用 DeepSeek Harness；Harness 必须 strategy=single，由完整 Harness Agent Loop 自己拆分任务，不由 Runner 按维度拆分。Pi 可通过 AUDIT_AGENT_TYPE=pi-docker 回滚；旧的 qwen-docker 名称保留兼容"
  }
}
